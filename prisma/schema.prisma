// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// A PG listing is a Property rather than a parallel model tree.
// Splitting it would mean a second copy of search, cards, photos, leads and soft-delete.
model Property {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  price            Int?
  yearlyPrice      Int?
  displayPrice     String?
  location         String?
  occupancyType    String?
  genderPreference String?
  lat              Float?
  lng              Float?
  deposit          Int?
  imageUrl         String?
  images           PropertyImage[]
  amenities        String[]        @default([])
  rules            String[]        @default([])
  description      String?

  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id])
  walkMinutes Int?
  landmark    String?

  foodType   String?
  messNote   String?
  vacantBeds Int?

  wardenName      String?
  gateClosingTime String?

  ownerName  String?
  ownerPhone String?

  verifiedAt DateTime?
  verifiedBy String?

  deletedAt DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads   Lead[]
  savedBy SavedProperty[]

  @@index([collegeId, genderPreference])
  @@index([price])
  @@index([deletedAt])
}

model College {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  shortName  String?
  aliases    String[]   @default([])
  area       String
  city       String     @default("Kolhapur")
  properties Property[]

  @@index([city])
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?
  image           String?
  phone           String?         @unique
  role            String          @default("student")
  accounts        Account[]
  sessions        Session[]
  savedProperties SavedProperty[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Lead {
  id         String    @id @default(cuid())
  name       String
  phone      String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  status     String    @default("New")
  stage      String    @default("NEW")
  source     String    @default("contact")
  notes      String?
  followupDate  DateTime?
  lastMessageAt DateTime?
  rawMessage    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([phone, propertyId])
  @@index([propertyId, createdAt])
}

model SavedProperty {
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tag        String?
  createdAt  DateTime @default(now())
}
