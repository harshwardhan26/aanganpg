// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// A PG listing is a Property rather than a parallel model tree.
// Splitting it would mean a second copy of search, cards, photos, leads and soft-delete.
model Property {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  price            Int?
  yearlyPrice      Int?
  displayPrice     String?
  location         String?
  occupancyType    String?
  genderPreference String?
  lat              Float?
  lng              Float?
  deposit          Int?
  imageUrl         String?
  images           PropertyImage[]
  amenities        String[]        @default([])
  rules            String[]        @default([])
  description      String?

  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id])
  walkMinutes Int?
  landmark    String?

  foodType   String?
  messNote   String?
  vacantBeds Int?

  /// The costs on top of rent — light bill, water, mess extra. Free text, not a
  /// set of booleans: the real answers are "light bill split between 4 boys,
  /// roughly ₹200 each", and a boolean per charge would need three more within
  /// a month. This is the number a family actually budgets against.
  costNote String?

  wardenName      String?
  gateClosingTime String?

  ownerName  String?
  ownerPhone String?

  verifiedAt DateTime?
  verifiedBy String?

  // Denormalised from Review, maintained on every review write.
  // The search page renders many cards at once, and computing these live meant
  // `include: { reviews: true }` on every row — every review of every listing
  // pulled across the wire to produce one number per card.
  ratingAvg   Float?
  ratingCount Int    @default(0)

  deletedAt DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads       Lead[]
  savedBy     SavedProperty[]
  reviews     Review[]
  reviewCodes ReviewCode[]

  @@index([collegeId, genderPreference])
  @@index([price])
  @@index([deletedAt])
}

model College {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  shortName  String?
  aliases    String[]   @default([])
  area       String
  city       String     @default("Kolhapur")
  properties Property[]

  @@index([city])
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?
  image           String?
  phone           String?         @unique
  accounts        Account[]
  sessions        Session[]
  savedProperties SavedProperty[]
  reviews         Review[]
  messMemberships MessMember[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Lead {
  id            String    @id @default(cuid())
  name          String
  phone         String
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id])
  /// "student" — someone enquiring about a room, created by `recordEnquiry`.
  /// "owner"   — a hostel owner being pitched, created by hand in the admin.
  /// Both run the same follow-up pipeline (`stage`, `followupDate`, `notes`),
  /// because the shape is genuinely the same: found them, spoke to them, met
  /// them, they said yes, they said no.
  kind          String    @default("student")
  /// Owner leads only. The hostel is not a Property yet — signing them up is
  /// the whole point of the call — so this is free text, not a relation.
  hostelName    String?
  status        String    @default("New")
  stage         String    @default("NEW")
  source        String    @default("contact")
  notes         String?
  followupDate  DateTime?
  lastMessageAt DateTime?
  rawMessage    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phone, propertyId])
  @@index([propertyId, createdAt])
  // The lead dashboard orders by recency and filters by stage; without these
  // both are sequential scans the moment the table stops being small.
  @@index([createdAt])
  @@index([stage])
  // Every inbox query is scoped to one kind, then ordered by date or filtered
  // by follow-up. Without these the split into Students/Owners turns each of
  // those into a full scan.
  @@index([kind, createdAt])
  @@index([kind, followupDate])
}

model SavedProperty {
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tag        String?
  createdAt  DateTime @default(now())
}

// A ticket, not a password. One code, one review: `usedAt` is stamped in the
// same transaction as the review it authorised, so a code that leaks — a photo
// of a notice board, a forwarded message — buys exactly one review and then
// nothing. `usedByUserId` keeps who spent it, so an odd review can be traced
// rather than only counted.
model ReviewCode {
  id         String    @id @default(cuid())
  code       String    @unique
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  usedAt       DateTime?
  usedByUserId String?

  @@index([propertyId])
  @@index([propertyId, usedAt])
}

model Review {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?  @db.Text
  verifiedVia String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, userId])
  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Mess management (Phase F)
//
// A separate island in the schema: the only thing it touches is `User`, through
// `MessMember`. Nothing here relates to Property, Lead or Review, so the whole
// module can be lifted out later without untangling the listing side.
// ---------------------------------------------------------------------------

model Mess {
  id                 String             @id @default(cuid())
  name               String
  address            String?
  contactPhone       String?
  setupCompletedAt   DateTime?
  scanKeyVersion     Int                @default(1)
  skipCutoffMinutes  Int                @default(1200)
  receiptCounter     Int                @default(0)
  subscriptionPlan   MessPlan           @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  /// Day of the month a fee becomes overdue. One number for the whole mess
  /// rather than one per student: every mess we have asked runs a single
  /// collection date, and a per-student date is a field nobody would ever fill
  /// in differently.
  dueDay             Int                @default(5)
  /// When each meal is served, in minutes past midnight IST. Six numbers rather
  /// than six strings: every comparison in the app is "is now inside this
  /// window", and a "07:30" that has to be parsed before it can be compared is
  /// a parse that will one day be skipped. The defaults are the times the first
  /// mess ran, so an existing row keeps behaving exactly as it did.
  breakfastFrom      Int                @default(390)
  breakfastTo        Int                @default(660)
  lunchFrom          Int                @default(660)
  lunchTo            Int                @default(960)
  dinnerFrom         Int                @default(1080)
  dinnerTo           Int                @default(1410)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members        MessMember[]
  students       Student[]
  menu           MenuItem[]
  paymentEntries PaymentEntry[]
  activityEvents ActivityEvent[]
  reminders      ReminderDelivery[]
  mealSkips      MealSkip[]
  kitchenLogs    KitchenLog[]
  notices        Notice[]
  invites        MessInvite[]
  feedback       MessFeedback[]
}

/**
 * What is being served.
 * A mess runs a weekly rotation, not a fresh decision each morning, so the
 * normal row has a `weekday` and repeats forever — twenty-one rows cover the
 * whole year. A `date` row is the exception: a festival, a special, a day the
 * vegetable did not arrive. Exactly one of the two is set.
 * Storing one row per calendar day instead would mean someone typing a menu 365
 * times a year, which is the version that gets abandoned in week two and leaves
 * students looking at a stale screen.
 */
model MenuItem {
  id     String @id @default(cuid())
  messId String
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday. Null on a one-off override.
  weekday Int?
  /// Set only on a one-off override for a single date. Null on a weekly row.
  date    DateTime? @db.Date
  meal    Meal
  /// Free text, as the owner writes it on the board. Not a list of dishes —
  /// "Rajma, rice, roti, salad" is one answer, and splitting it would invent
  /// structure nobody maintains.
  items   String

  updatedAt DateTime @updatedAt

  @@unique([messId, weekday, meal])
  @@unique([messId, date, meal])
  @@index([messId])
}

/**
 * Who may open a mess, and as what.
 * Per-mess membership rather than a column on `User`: the global `role` in the
 * session is derived from ADMIN_EMAILS and answers "does this person run
 * Aangan", which is a different question from "does this person run *this*
 * mess". A mess owner is a customer, not an operator, and an env allowlist
 * cannot express one person owning one mess.
 */
model MessMember {
  id     String   @id @default(cuid())
  messId String
  mess   Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   MessRole

  createdAt DateTime @default(now())

  @@unique([messId, userId])
  @@index([userId])
}

enum MessRole {
  OWNER
  STAFF
}

model Student {
  id     String @id @default(cuid())
  messId String
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)

  name        String
  /// Left over from an earlier version of the form. Nothing reads or writes it;
  /// it stays only because dropping a column costs a migration on live data.
  room        String?
  /// The Google account the student signs in with, matched against the session
  /// when they scan. Unique per mess, not globally: two messes may legitimately
  /// have the same student.
  email       String?
  /// Taken at enrollment. The owner glances at this on the receipt before
  /// handing over a plate — it is what makes a forwarded receipt fail.
  photoUrl    String?
  parentName  String?
  /// E.164 through `canonicalPhone()`, like every other phone column.
  parentPhone String?
  /// Rupees per month. Nullable means "not set yet", never 0 — a 0 fee is a real
  /// answer (a free student) and must survive.
  monthlyFee  Int?
  joinedAt    DateTime  @default(now())
  /// Soft-leave. A student who leaves keeps their attendance history, because the
  /// history is the thing anyone would ever ask about after they are gone.
  leftAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]
  payments   Payment[]
  mealSkips  MealSkip[]
  feedback   MessFeedback[]

  @@unique([messId, email])
  @@index([messId, leftAt])
}

/**
 * One row per student per billing month — but only once something has happened.
 * There is deliberately no monthly job that pre-creates a row for every student:
 * an unpaid month with no reminder yet is the absence of a row, which is exactly
 * what it means. A row appears when the fee is paid or when the first reminder
 * goes out, and `amount` is copied in at that moment so raising the fee later
 * does not rewrite what someone already paid.
 */
model Payment {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// The first of the billing month, midnight IST stored as a date.
  month     DateTime  @db.Date
  /// Rupees, as they stood when this row was written.
  amount    Int?
  paidAt    DateTime?

  remindersSent  Int       @default(0)
  lastReminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   PaymentEntry[]
  reminders ReminderDelivery[]

  @@unique([studentId, month])
  @@index([month])
}

/**
 * One row per student per day. `day` is midnight IST stored as UTC — the same
 * boundary `startOfIstDay` gives the lead views, so "today" means one thing
 * across the app. The unique index is what makes a double-tap idempotent
 * instead of a duplicate.
 */
model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  day       DateTime         @db.Date
  meal      Meal
  method    AttendanceMethod @default(MANUAL)
  markedAt  DateTime         @default(now())

  @@unique([studentId, day, meal])
  @@index([day])
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
}

enum AttendanceMethod {
  /// Staff tapped the name. The fallback, and what a dead phone falls back to.
  MANUAL
  /// The student scanned the poster themselves.
  SCAN
  FACE
}

enum MessPlan {
  TRIAL
  STARTER
  GROWTH
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

enum FeeEntryKind {
  PAYMENT
  REFUND
  DISCOUNT
  EXTRA_CHARGE
  CREDIT
}

enum PaymentMethod {
  CASH
  UPI
  BANK
  OTHER
}

model PaymentEntry {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  messId    String
  mess      Mess    @relation(fields: [messId], references: [id], onDelete: Cascade)

  kind              FeeEntryKind
  amount            Int
  method            PaymentMethod?
  // What was typed, kept forever: the audit trail must survive a reversal.
  externalReference String?
  // The same string while the entry stands, NULL once it is reversed. The
  // uniqueness lives here rather than on `externalReference` so that reversing
  // a payment recorded against the wrong student hands the UPI reference back
  // instead of burning it for the life of the mess.
  activeReference   String?
  receiptNumber     String?
  note              String?
  occurredAt        DateTime       @default(now())
  createdById       String
  reversedAt        DateTime?
  reversedById      String?
  reversalReason    String?
  createdAt         DateTime       @default(now())

  @@unique([messId, receiptNumber])
  @@unique([messId, activeReference])
  @@index([paymentId, occurredAt])
  @@index([messId, occurredAt])
}

model ActivityEvent {
  id          String   @id @default(cuid())
  messId      String
  mess        Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  actorUserId String?
  kind        String
  entityType  String
  entityId    String?
  summary     String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([messId, createdAt])
}

enum ReminderChannel {
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model ReminderDelivery {
  id          String          @id @default(cuid())
  messId      String
  mess        Mess            @relation(fields: [messId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  channel     ReminderChannel
  target      String
  status      DeliveryStatus  @default(PENDING)
  providerRef String?
  error       String?
  automated   Boolean         @default(false)
  createdById String?
  sentAt      DateTime?
  createdAt   DateTime        @default(now())

  @@index([messId, createdAt])
  @@index([paymentId, createdAt])
}

model MealSkip {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  meal      Meal
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, day, meal])
  @@index([messId, day, meal])
}

model KitchenLog {
  id            String   @id @default(cuid())
  messId        String
  mess          Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  day           DateTime @db.Date
  meal          Meal
  preparedCount Int
  leftoverCount Int
  note          String?
  updatedById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([messId, day, meal])
  @@index([messId, day])
}

enum NoticeAudience {
  ALL
  STUDENTS
  STAFF
}

model Notice {
  id          String         @id @default(cuid())
  messId      String
  mess        Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  title       String
  body        String
  audience    NoticeAudience @default(ALL)
  startsAt    DateTime       @default(now())
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime       @default(now())

  @@index([messId, startsAt])
  @@index([messId, expiresAt])
}

model MessInvite {
  id          String    @id @default(cuid())
  messId      String
  mess        Mess      @relation(fields: [messId], references: [id], onDelete: Cascade)
  email       String
  role        MessRole  @default(STAFF)
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([messId, email])
  @@index([email, acceptedAt])
}

enum FeedbackCategory {
  FOOD
  CLEANLINESS
  SERVICE
  BILLING
  OTHER
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

model MessFeedback {
  id            String           @id @default(cuid())
  messId        String
  mess          Mess             @relation(fields: [messId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category      FeedbackCategory
  rating        Int?
  message       String
  status        FeedbackStatus   @default(OPEN)
  ownerResponse String?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([messId, status, createdAt])
  @@index([studentId, createdAt])
}
