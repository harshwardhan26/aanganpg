// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// A PG listing is a Property rather than a parallel model tree.
// Splitting it would mean a second copy of search, cards, photos, leads and soft-delete.
model Property {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  price            Int?
  yearlyPrice      Int?
  displayPrice     String?
  location         String?
  occupancyType    String?
  genderPreference String?
  lat              Float?
  lng              Float?
  deposit          Int?
  imageUrl         String?
  images           PropertyImage[]
  amenities        String[]        @default([])
  rules            String[]        @default([])
  description      String?

  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id])
  walkMinutes Int?
  landmark    String?

  foodType   String?
  messNote   String?
  vacantBeds Int?

  /// The costs on top of rent — light bill, water, mess extra. Free text, not a
  /// set of booleans: the real answers are "light bill split between 4 boys,
  /// roughly ₹200 each", and a boolean per charge would need three more within
  /// a month. This is the number a family actually budgets against.
  costNote String?

  wardenName      String?
  gateClosingTime String?

  ownerName  String?
  ownerPhone String?

  verifiedAt DateTime?
  verifiedBy String?

  // Denormalised from Review, maintained on every review write.
  // The search page renders many cards at once, and computing these live meant
  // `include: { reviews: true }` on every row — every review of every listing
  // pulled across the wire to produce one number per card.
  ratingAvg   Float? 
  ratingCount Int     @default(0)

  deletedAt DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads   Lead[]
  savedBy SavedProperty[]
  reviews     Review[]
  reviewCodes ReviewCode[]

  @@index([collegeId, genderPreference])
  @@index([price])
  @@index([deletedAt])
}

model College {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  shortName  String?
  aliases    String[]   @default([])
  area       String
  city       String     @default("Kolhapur")
  properties Property[]

  @@index([city])
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?
  image           String?
  phone           String?         @unique
  accounts        Account[]
  sessions        Session[]
  savedProperties SavedProperty[]
  reviews         Review[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Lead {
  id         String    @id @default(cuid())
  name       String
  phone      String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  /// "student" — someone enquiring about a room, created by `recordEnquiry`.
  /// "owner"   — a hostel owner being pitched, created by hand in the admin.
  /// Both run the same follow-up pipeline (`stage`, `followupDate`, `notes`),
  /// because the shape is genuinely the same: found them, spoke to them, met
  /// them, they said yes, they said no.
  kind       String    @default("student")
  /// Owner leads only. The hostel is not a Property yet — signing them up is
  /// the whole point of the call — so this is free text, not a relation.
  hostelName String?
  status     String    @default("New")
  stage      String    @default("NEW")
  source     String    @default("contact")
  notes      String?
  followupDate  DateTime?
  lastMessageAt DateTime?
  rawMessage    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([phone, propertyId])
  @@index([propertyId, createdAt])
  // The lead dashboard orders by recency and filters by stage; without these
  // both are sequential scans the moment the table stops being small.
  @@index([createdAt])
  @@index([stage])
  // Every inbox query is scoped to one kind, then ordered by date or filtered
  // by follow-up. Without these the split into Students/Owners turns each of
  // those into a full scan.
  @@index([kind, createdAt])
  @@index([kind, followupDate])
}

model SavedProperty {
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tag        String?
  createdAt  DateTime @default(now())
}

// A ticket, not a password. One code, one review: `usedAt` is stamped in the
// same transaction as the review it authorised, so a code that leaks — a photo
// of a notice board, a forwarded message — buys exactly one review and then
// nothing. `usedByUserId` keeps who spent it, so an odd review can be traced
// rather than only counted.
model ReviewCode {
  id         String   @id @default(cuid())
  code       String   @unique
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime?

  usedAt       DateTime?
  usedByUserId String?

  @@index([propertyId])
  @@index([propertyId, usedAt])
}

model Review {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  verifiedVia String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, userId])
  @@index([propertyId])
}
