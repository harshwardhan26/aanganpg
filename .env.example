DATABASE_URL="" # PostgreSQL connection string. Must be a real Postgres that accepts
                # concurrent connections — a local `prisma dev` server accepts one at a
                # time, so any Promise.all of two queries fails with P1017.
NEXTAUTH_URL="" # Base URL of the application, e.g., http://localhost:3000. LEAVE THIS EMPTY in
                # production: the app answers on two hosts (aanganpg.com and
                # mess.aanganpg.com) and next-auth pins every callback to this value when it
                # is set, which would send a mess sign-in back to the room site. Unset on
                # Vercel it uses the incoming host, so each site signs in as itself. Set
                # AUTH_TRUST_HOST=1 to get the same behaviour outside Vercel.
NEXTAUTH_SECRET="" # Secret string for signing NextAuth tokens
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="" # Cloudinary cloud name for direct uploads and transforms
NEXT_PUBLIC_CLOUDINARY_PRESET="" # Cloudinary unsigned upload preset name
UPSTASH_REDIS_REST_URL="" # Upstash Redis REST URL for rate limiting
UPSTASH_REDIS_REST_TOKEN="" # Upstash Redis REST token
NEXT_PUBLIC_POSTHOG_KEY="" # PostHog project API key
NEXT_PUBLIC_POSTHOG_HOST="" # PostHog host URL, e.g., https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN="" # Sentry Data Source Name for error tracking
NEXT_PUBLIC_SITE_URL="" # Canonical base URL for sitemap and absolute links
MESS_URL="" # Origin of the mess site, e.g., https://mess.aanganpg.com. Printed on the QR
            # poster and used to move mess links to the other host. Server-side only, so no
            # NEXT_PUBLIC_ prefix. Empty falls back to "mess." + the site host, which is what
            # makes http://mess.localhost:3000 work in development.
NEXT_PUBLIC_AANGAN_PHONE="" # Aangan's public contact number for support/issues
GOOGLE_CLIENT_ID=""     # Google OAuth client ID, from console.cloud.google.com > Google Auth Platform > Clients
GOOGLE_CLIENT_SECRET="" # Google OAuth client secret for the same client
ADMIN_EMAILS=""  # Comma-separated Google emails that get the admin panel
CRON_SECRET="" # Shared secret Vercel Cron sends as `Authorization: Bearer ...`. Without it
               # the mess reminder job refuses every request, including Vercel's.
SMS_API_KEY=""     # MSG91 auth key. Absent = the reminder job logs what it would send
                   # and sends nothing, which is the right state until DLT clears.
SMS_SENDER_ID=""   # DLT-registered 6-character sender ID
SMS_TEMPLATE_ID="" # DLT-registered template id the message body must match

